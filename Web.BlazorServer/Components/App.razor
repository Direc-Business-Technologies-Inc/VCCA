<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/Radzen.Blazor/css/default.css" rel="stylesheet" />
    <link rel="stylesheet" href="Web.BlazorServer.styles.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <HeadOutlet @rendermode="InteractiveServer" />
    <RadzenTheme Theme="standard" @rendermode="InteractiveServer" />
    @* Material 3 Expressive override — must load AFTER RadzenTheme so :root wins. Remove this line to revert. *@
    <link rel="stylesheet" href="css/material3-expressive.css" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/custom-scripts/login.js"></script>
    <script src="js/custom-scripts/logout.js"></script>
    <script src="js/custom-scripts/pdf-utils.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>

</html>
